{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc && node scripts/watch-templates.js",
    "build:watch": "tsc --watch",
    "templates:watch": "node scripts/watch-templates.js --watch",
    "start": "node ./dist/server.js",
    "pm2:start": "pm2 start ./dist/server.js --name travis-backend",
    "pm2:stop": "pm2 stop travis-backend",
    "pm2:delete": "pm2 delete travis-backend",
    "pm2:watch": "concurrently -k \"npm:build:watch\" \"npm:templates:watch\" \"pm2 start ecosystem.config.cjs\""
  },
